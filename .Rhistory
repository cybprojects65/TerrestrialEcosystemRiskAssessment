"out065_number_species_cum_all_2024pr"
),
~ (.-mean(., na.rm = TRUE)) / sd(., na.rm = TRUE)#è la formula per standardizzare ogni colonna, considerando eventuali NA (valori mancanti). Toglie la media da ogno valore e divide per la deviazione standard
)
)
# cat("Exporting variables_risk1_standardized dataframe to CSV...\n")
# write.csv(variables_risk1_standardized, "output/variables_risk1_standardized.csv", row.names = FALSE)
# cat("Export completed.\n")
#--- Step 7. Selection of points without NA values ---####
variables_risk1_standardized_no_na <- variables_risk1_standardized %>%
filter(complete.cases(.))
#--- Step 8. Calcolo del rischio standardizzato tramite scoring ---####
# Calcolo delle metriche di rischio
risk1_overlap_standardized <- variables_risk1_standardized_no_na %>%
# Rischio totale = somma dei valori standardizzati delle variabili e poi normalizzati
mutate(
standard_risk_score = rowSums(across(-c("x", "y")), na.rm = TRUE), #esclude le colonne x e y e somma i valori standardizzati
# Normalizzazione del punteggio di rischio totale
# standard_risk_score_normalized = (total_risk_score - min(total_risk_score, na.rm = TRUE)) /
#   (max(total_risk_score, na.rm = TRUE) - min(total_risk_score, na.rm = TRUE)),
# Categorizzazione del punteggio di rischio
# total_risk_category = case_when(
#   total_risk_score_normalized < 0.33 ~ "Low",
#   total_risk_score_normalized < 0.66 ~ "Medium",
#   TRUE ~ "High"
# ),
# add a new column ‘overlap_index_classification’ and assign the values:
# low risk up to the 50th percentile
# medium risk from the 50th to the 75th percentile
# high risk above the 75th percentile
overlap_index_classification = case_when(
standard_risk_score <= quantile(standard_risk_score, 0.5, na.rm = TRUE) ~ "low risk",
standard_risk_score > quantile(standard_risk_score, 0.5, na.rm = TRUE) & standard_risk_score <= quantile(standard_risk_score, 0.75, na.rm = TRUE) ~ "medium risk",
standard_risk_score > quantile(standard_risk_score, 0.75, na.rm = TRUE) ~ "high risk",
TRUE ~ NA_character_ # in case of NA values
),
# Rischio H-F = differenza tra Harmful force & Fragile condition dei valori standardizzati delle variabili e poi normalizzati
# Calcolo del punteggio di rischio Harmful force = somma dei valori standardizzati delle variabili escludendo le colonne x, y e le variabili fragile condition
harmful_risk_score = rowSums(select(., -c(
"x",
"y",
"out009_tree_cover_density_2024pr",
"out011_grassland_2024pr",
"out040_plant_phenology_index_total_productivity_2024pr",
"out065_number_species_cum_all_2024pr"
)), na.rm = TRUE),
# Calcolo del punteggio di rischio Fragile condition = somma dei valori standardizzati delle variabili escludendo le colonne x, y e le variabili harmful force
fragile_risk_score = rowSums(select(., -c(
"x",
"y",
"out003_land_imperviousness_density_change_2024pr",
"out010_tree_cover_density_change_2024pr",
"out012_grassland_change_2024pr",
"out017_land_use_and_cover_nature_2k_2024pr",
"out057_temperature_avg_absolute_change_2024pr_rcp85",
"out058_potential_evapotranspiration_relative_change_2024pr_rcp85",
"out059_precipitation_cum_relative_change_2024pr_rcp85",
"out147_land_use_and_cover_change_2024pr"
)), na.rm = TRUE),
# Calcolo del punteggio di rischio totale come differenza tra Harmful force e Fragile condition
diff_harmful_fragile_risk_score = harmful_risk_score - fragile_risk_score,
# Normalizzazione del punteggio di Rischio H-F
diff_harmful_fragile_risk_score_normalized =
(diff_harmful_fragile_risk_score - min(diff_harmful_fragile_risk_score, na.rm = TRUE)) /
(max(diff_harmful_fragile_risk_score, na.rm = TRUE) - min(diff_harmful_fragile_risk_score, na.rm = TRUE)),
# Categorizzazione del punteggio di rischio H-F
diff_harmful_fragile_risk_category = case_when(
diff_harmful_fragile_risk_score_normalized < 0.33 ~ "Low",
diff_harmful_fragile_risk_score_normalized < 0.66 ~ "Medium",
TRUE ~ "High"
)
)
# Esportazione CSV
# cat("Exporting risk1_overlap_standardized dataframe to CSV...\n")
# write.csv(risk1_overlap_standardized, "output/risk1_overlap_standardized.csv", row.names = FALSE)  # corretto qui: nome oggetto era sbagliato
# cat("Export completed.\n")
#--- Step 8. Selezione dei punti senza valori NA ---####
# Selezione dei punti senza valori NA
risk1_overlap_standardized_no_na <- risk1_overlap_standardized %>%
filter(complete.cases(.)) #esclude le righe con NA
# Esportazione CSV risk1_no_na
cat("Exporting risk1_overlap_standardized_no_na dataframe to CSV...\n")
write.csv(risk1_overlap_standardized_no_na, "output/risk1_overlap_standardized_no_na_MOD01.csv", row.names = FALSE)
cat("Export completed.\n")
