rm(list = ls())
#library(dplyr)
library(tidyverse)
#--- Step 1. Selezione delle variabili per il calcolo del rischio 1 ed esportazione in CSV della tabella originale ---####
all_variables <- read.csv("input/data_values.csv", sep = ",", header = TRUE, stringsAsFactors = FALSE)
#head(all_variables)
# colonne da selezionare
variables_risk1_original <- all_variables [, c(
"x",
"y",
"out003_land_imperviousness_density_change_2024pr",
"out009_tree_cover_density_2024pr",
"out010_tree_cover_density_change_2024pr",
"out011_grassland_2024pr",
"out012_grassland_change_2024pr",
"out017_land_use_and_cover_nature_2k_2024pr",
"out040_plant_phenology_index_total_productivity_2024pr",
"out057_temperature_avg_absolute_change_2024pr_rcp85",
"out058_potential_evapotranspiration_relative_change_2024pr_rcp85",
"out059_precipitation_cum_relative_change_2024pr_rcp85",
"out065_number_species_cum_all_2024pr",
"out147_land_use_and_cover_change_2024pr"
)]   # <-- inserisci qui i codici che ti servono
# Esportazione CSV variables_risk1_original
cat("Exporting variables_risk1_original dataframe to CSV...\n")
write.csv(variables_risk1_original, "output/variables_risk1_original.csv", row.names = FALSE)
cat("Export completed.\n")
#--- Step 2. Preprocessamento: Riclassificazione dei valori delle variabili ---####
# per ogni variabile:
# a- diretta: riportare as-is
# b- inversa: riportare 1/ variabile, se riclassificata riportare as-is
# c- categoriale booleana: riportare 1 (variabile piena) 0 (variabile NA oppure categoria esclusa)
# d- categoriale semantica: assegnare da 1 a N per ogni categoria con semantica incrementale
# e- invertire  (1/var) variabili categoriali "inverse"
# Variabili categoriali da riclassificare
variables_risk1_reclassified <- variables_risk1_original %>%
mutate(
out003_land_imperviousness_density_change_2024pr = case_when(
out003_land_imperviousness_density_change_2024pr == 201 ~ 100, #unchanged areas with no imperviousness
out003_land_imperviousness_density_change_2024pr == 254 ~ NA, #new imperviousness
out003_land_imperviousness_density_change_2024pr == 255 ~ NA, #loss of imperviousness
TRUE ~ out003_land_imperviousness_density_change_2024pr       # else remain the same
),
out010_tree_cover_density_change_2024pr = case_when(
out010_tree_cover_density_change_2024pr == 0  ~ 0,  #unchanged areas with no tree cover
out010_tree_cover_density_change_2024pr == 1  ~ 1,  #new tree cover
out010_tree_cover_density_change_2024pr == 2  ~ -1, #loss of tree cover
out010_tree_cover_density_change_2024pr == 10 ~ 0,  #unchanged areas with tree cover
TRUE ~ 0 #else
),
out012_grassland_change_2024pr = case_when(
out012_grassland_change_2024pr == 0  ~ 0,  #Unchanged non-grassland in both years
out012_grassland_change_2024pr == 1  ~ 1,  #Grassland gain (added for completeness but not present in the data)
out012_grassland_change_2024pr == 2  ~ -1, #Grassland loss
out012_grassland_change_2024pr == 10 ~ 0,  #Unchanged grassland in both years
out012_grassland_change_2024pr == 11 ~ 1,  #Unverified grassland gain
out012_grassland_change_2024pr == 22 ~ -1, #Unverified grassland loss
TRUE ~ 0 #else
),
out017_land_use_and_cover_nature_2k_2024pr = case_when(
out017_land_use_and_cover_nature_2k_2024pr %in% c(1120, 1310, 8120) ~ 1, #1120 Industrial, commercial and military units, 1310 Mineral extraction, dump and construction sites, 8120 Highly modified water courses and canals
TRUE ~ 0 #else
),
out147_land_use_and_cover_change_2024pr = case_when(
out147_land_use_and_cover_change_2024pr == 1 ~ 1,   # Territori modellati artificialmente
out147_land_use_and_cover_change_2024pr == 2 ~ 0.5, # Superfici agricole utilizzate
out147_land_use_and_cover_change_2024pr == 5 ~ -1,  # Corpi idrici
TRUE ~ 0 #else
)
)
cat("Exporting variables_risk1_reclassified dataframe to CSV...\n")
write.csv(variables_risk1_reclassified, "output/variables_risk1_reclassified.csv", row.names = FALSE)
cat("Export completed.\n")
#--- Step 3. Preprocessamento: Inversione dei valori delle variabili ---####
# Selezione delle variabili categoriali da invertire
variables_risk1_reclassified_inverted <- variables_risk1_reclassified %>%
mutate(
out010_tree_cover_density_change_2024pr =
-1 * out010_tree_cover_density_change_2024pr,
out012_grassland_change_2024pr =
-1 * out012_grassland_change_2024pr,
out058_potential_evapotranspiration_relative_change_2024pr_rcp85 =
-1 * out058_potential_evapotranspiration_relative_change_2024pr_rcp85,
out059_precipitation_cum_relative_change_2024pr_rcp85 =
-1 * out059_precipitation_cum_relative_change_2024pr_rcp85
# Esempio per invertire una variabile totalmente positiva o negativa
# Attenzione: I valori che risultano 0 non vanno invertiti perchè 1/0 = inf, quindi vanno gestiti
# out058_potential_evapotranspiration_relative_change_2024pr_rcp85 =
#   if_else(out058_potential_evapotranspiration_relative_change_2024pr_rcp85 != 0,
#           1 / out058_potential_evapotranspiration_relative_change_2024pr_rcp85,
#           0),
)
# print(unique(variables_risk1_reclassified$out010_tree_cover_density_change_2024pr))
# Esportazione CSV variables_risk1_reclassified
cat("Exporting variables_risk1_reclassified_inverted dataframe to CSV...\n")
write.csv(variables_risk1_reclassified_inverted, "output/variables_risk1_reclassified_inverted.csv", row.names = FALSE)
cat("Export completed.\n")
#--- Step 4. Normalizzazione delle variabili ---####
# Normalizzazione delle variabili per ogni colonna: nuovo valore = (valore - valore min) / (valore max - valore min)
variables_risk1_normalized <- variables_risk1_reclassified_inverted %>%
mutate(
across(
c(
"out003_land_imperviousness_density_change_2024pr",
"out009_tree_cover_density_2024pr",
"out010_tree_cover_density_change_2024pr",
"out011_grassland_2024pr",
"out012_grassland_change_2024pr",
"out017_land_use_and_cover_nature_2k_2024pr",
"out040_plant_phenology_index_total_productivity_2024pr",
"out057_temperature_avg_absolute_change_2024pr_rcp85",
"out058_potential_evapotranspiration_relative_change_2024pr_rcp85",
"out059_precipitation_cum_relative_change_2024pr_rcp85",
"out065_number_species_cum_all_2024pr",
"out147_land_use_and_cover_change_2024pr"
),
~ (. - min(., na.rm = TRUE)) / (max(., na.rm = TRUE) - min(., na.rm = TRUE)) #è la formula per normalizzare ogni colonna, considerando eventuali NA (valori mancanti).
)
)
#cat("Exporting variables_risk1_normalized dataframe to CSV...\n")
#write.csv(variables_risk1_normalized, "output/variables_risk1_normalized.csv", row.names = FALSE)
#cat("Export completed.\n")
#--- Step 5. Calcolo del rischio normalizzato tramite scoring ---####
variables_risk1_normalized <- variables_risk1_normalized %>%
mutate(
total_risk_score_normalized = rowSums(across(-c("x", "y")), na.rm = TRUE), #esclude le colonne x e y e somma i valori standardizzati
)
# Selezione dei punti senza valori NA
variables_risk1_normalized_no_na <- variables_risk1_normalized %>%
filter(complete.cases(.)) #esclude le righe con NA
# Esportazione CSV variables_risk1_normalized_no_na
cat("Exporting variables_risk1_normalized dataframe to CSV...\n")
write.csv(variables_risk1_normalized_no_na, "output/risk1_overlap_normalized_no_na.csv", row.names = FALSE)
cat("Export completed.\n")
#--- Step 6. Standardizzazione delle variabili (Z-Score) ---####
# Standardizzazione delle variabili per ogni colonna: nuovo valore = (valore - media) / sd
variables_risk1_standardized <- variables_risk1_reclassified_inverted %>%
mutate(
across(
c(
"out003_land_imperviousness_density_change_2024pr",
"out009_tree_cover_density_2024pr",
"out040_plant_phenology_index_total_productivity_2024pr",
"out057_temperature_avg_absolute_change_2024pr_rcp85",
"out058_potential_evapotranspiration_relative_change_2024pr_rcp85",
"out059_precipitation_cum_relative_change_2024pr_rcp85",
"out065_number_species_cum_all_2024pr"
),
~ (.-mean(., na.rm = TRUE)) / sd(., na.rm = TRUE)#è la formula per standardizzare ogni colonna, considerando eventuali NA (valori mancanti). Toglie la media da ogno valore e divide per la deviazione standard
)
)
# cat("Exporting variables_risk1_standardized dataframe to CSV...\n")
# write.csv(variables_risk1_standardized, "output/variables_risk1_standardized.csv", row.names = FALSE)
# cat("Export completed.\n")
#--- Step 7. Calcolo del rischio standardizzato tramite scoring ---####
# Calcolo delle metriche di rischio
risk1_overlap_standardized <- variables_risk1_standardized %>%
# Rischio totale = somma dei valori standardizzati delle variabili e poi normalizzati
mutate(
standard_risk_score = rowSums(across(-c("x", "y")), na.rm = TRUE), #esclude le colonne x e y e somma i valori standardizzati
# Normalizzazione del punteggio di rischio totale
# standard_risk_score_normalized = (total_risk_score - min(total_risk_score, na.rm = TRUE)) /
#   (max(total_risk_score, na.rm = TRUE) - min(total_risk_score, na.rm = TRUE)),
# Categorizzazione del punteggio di rischio
# total_risk_category = case_when(
#   total_risk_score_normalized < 0.33 ~ "Low",
#   total_risk_score_normalized < 0.66 ~ "Medium",
#   TRUE ~ "High"
# ),
# add a new column ‘overlap_index_classification’ and assign the values:
# low risk up to the 50th percentile
# medium risk from the 50th to the 75th percentile
# high risk above the 75th percentile
overlap_index_classification = case_when(
standard_risk_score <= quantile(standard_risk_score, 0.5, na.rm = TRUE) ~ "low risk",
standard_risk_score > quantile(standard_risk_score, 0.5, na.rm = TRUE) & standard_risk_score <= quantile(standard_risk_score, 0.75, na.rm = TRUE) ~ "medium risk",
standard_risk_score > quantile(standard_risk_score, 0.75, na.rm = TRUE) ~ "high risk",
TRUE ~ NA_character_ # in case of NA values
),
# Rischio H-F = differenza tra Harmful force & Fragile condition dei valori standardizzati delle variabili e poi normalizzati
# Calcolo del punteggio di rischio Harmful force = somma dei valori standardizzati delle variabili escludendo le colonne x, y e le variabili fragile condition
harmful_risk_score = rowSums(select(., -c(
"x",
"y",
"out009_tree_cover_density_2024pr",
"out011_grassland_2024pr",
"out040_plant_phenology_index_total_productivity_2024pr",
"out065_number_species_cum_all_2024pr"
)), na.rm = TRUE),
# Calcolo del punteggio di rischio Fragile condition = somma dei valori standardizzati delle variabili escludendo le colonne x, y e le variabili harmful force
fragile_risk_score = rowSums(select(., -c(
"x",
"y",
"out003_land_imperviousness_density_change_2024pr",
"out010_tree_cover_density_change_2024pr",
"out012_grassland_change_2024pr",
"out017_land_use_and_cover_nature_2k_2024pr",
"out057_temperature_avg_absolute_change_2024pr_rcp85",
"out058_potential_evapotranspiration_relative_change_2024pr_rcp85",
"out059_precipitation_cum_relative_change_2024pr_rcp85",
"out147_land_use_and_cover_change_2024pr"
)), na.rm = TRUE),
# Calcolo del punteggio di rischio totale come differenza tra Harmful force e Fragile condition
diff_harmful_fragile_risk_score = harmful_risk_score - fragile_risk_score,
# Normalizzazione del punteggio di Rischio H-F
diff_harmful_fragile_risk_score_normalized =
(diff_harmful_fragile_risk_score - min(diff_harmful_fragile_risk_score, na.rm = TRUE)) /
(max(diff_harmful_fragile_risk_score, na.rm = TRUE) - min(diff_harmful_fragile_risk_score, na.rm = TRUE)),
# Categorizzazione del punteggio di rischio H-F
diff_harmful_fragile_risk_category = case_when(
diff_harmful_fragile_risk_score_normalized < 0.33 ~ "Low",
diff_harmful_fragile_risk_score_normalized < 0.66 ~ "Medium",
TRUE ~ "High"
)
)
# Esportazione CSV
# cat("Exporting risk1_overlap_standardized dataframe to CSV...\n")
# write.csv(risk1_overlap_standardized, "output/risk1_overlap_standardized.csv", row.names = FALSE)  # corretto qui: nome oggetto era sbagliato
# cat("Export completed.\n")
#--- Step 8. Selezione dei punti senza valori NA ---####
# Selezione dei punti senza valori NA
risk1_overlap_standardized_no_na <- risk1_overlap_standardized %>%
filter(complete.cases(.)) #esclude le righe con NA
# Esportazione CSV risk1_no_na
cat("Exporting risk1_overlap_standardized_no_na dataframe to CSV...\n")
write.csv(risk1_overlap_standardized_no_na, "output/risk1_overlap_standardized_no_na_MOD01.csv", row.names = FALSE)
cat("Export completed.\n")
